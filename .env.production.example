# ============================================================
# GTEX Production Environment Template
# Copy to .env and fill in real values before deploying.
# DO NOT commit this file with real secrets.
# ============================================================

# --- Database (Neon PostgreSQL) ---
# Neon provides a connection string starting with postgres:// or postgresql://
# The backend normalises it automatically to postgresql+psycopg://
# Always append ?sslmode=require for Neon.
DATABASE_URL=

# Optional read replica (Neon branching)
# GTE_DATABASE_READ_URL=

# --- Cache (Upstash Redis) ---
# Set REDIS_ENABLED=true when Upstash is provisioned.
# Leave false to run with in-process NullCache fallback.
REDIS_ENABLED=false
REDIS_URL=

# --- Cloudinary (media delivery only — no uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- API versioning ---
API_VERSION=2

# --- Feature flags ---
ENABLE_REALTIME=true
ENABLE_COMPETITIONS=true
ENABLE_TRADER=true
ENABLE_WALLETS=true

# --- Backend runtime ---
GTE_APP_ENV=production
GTE_APP_NAME=Global Talent Exchange API
GTE_APP_VERSION=0.1.0
GTE_PHASE_MARKER=phase-8

# --- Auth secrets (generate with: openssl rand -hex 32) ---
GTE_AUTH_SECRET=
GTE_MEDIA_SIGNING_SECRET=

# --- CORS ---
GTE_CORS_ALLOW_ORIGINS=https://<your-cloudflare-pages-domain>
GTE_CORS_ALLOW_ORIGIN_REGEX=
GTE_CORS_ALLOW_CREDENTIALS=false

# --- Sportmonks ingestion ---
GTE_INGESTION_PROVIDER=sportmonks
GTE_REAL_PLAYER_IMPORT_PROVIDER=sportmonks
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_API_TOKEN=

# --- Email (Brevo SMTP) ---
EMAIL_ENABLED=true
EMAIL_PROVIDER=brevo_smtp
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=GTEX
EMAIL_REPLY_TO=support@example.com
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_USE_TLS=true
BREVO_SMTP_USE_SSL=false

# --- Payment gateways ---
GTE_PAYSTACK_SECRET_KEY=
GTE_PAYSTACK_WEBHOOK_SECRET=
GTE_PAYSTACK_CALLBACK_URL=https://<your-cloudflare-pages-domain>/payment/callback
GTE_KORAPAY_SECRET_KEY=
GTE_KORAPAY_WEBHOOK_SECRET=
GTE_KORAPAY_REDIRECT_URL=https://<your-cloudflare-pages-domain>/payment/redirect
GTE_KORAPAY_NOTIFICATION_URL=https://<your-render-backend-url>/api/v2/payments/korapay/webhook

# --- Worker settings ---
GTE_TASK_QUEUE_ENABLED=true
GTE_OUTBOX_RELAY_ENABLED=false
GTE_RUN_MIGRATION_CHECK=true
RUN_STARTUP_SEEDING=false

# --- Observability (optional) ---
GTE_LOG_JSON=true
GTE_METRICS_ENABLED=true
GTE_OBSERVABILITY_TRACING_ENABLED=false
GTE_OTEL_SERVICE_NAME=gtex-api
GTE_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
